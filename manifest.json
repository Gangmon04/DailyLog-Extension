{
  "manifest_version": 3,
  "name": "DailyLog",
  "version": "1.0.0",
  "description": "Track daily work modules, tasks, and generate 1-click Standup, Plain Text, or Markdown updates.",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "notifications",
    "tts",
    "sidePanel",
    "tabs"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DailyLog: Today's Tasks",
    "default_icon": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Open Daily Tasks Popup"
    }
  }
}